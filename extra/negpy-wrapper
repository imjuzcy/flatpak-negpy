#!/bin/bash
# Keep NegPy's databases, presets, cache and default exports in the app's
# data dir (~/.var/app/com.marcinz606.NegPy/data/NegPy) instead of ~/Documents/NegPy.
export NEGPY_USER_DIR="${NEGPY_USER_DIR:-${XDG_DATA_HOME}/NegPy}"

cd /app/opt/negpy
exec python3 desktop.py -platform wayland -platformtheme kde "$@"
